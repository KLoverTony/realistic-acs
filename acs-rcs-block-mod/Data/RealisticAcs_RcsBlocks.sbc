<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CubeBlocks>
    <!--
      This is intentionally a near-zero-force gyro definition. It gives the block
      a standard functional-block lifecycle, power sink, damage state, and terminal
      UI. The ACS plugin identifies these subtype IDs and supplies finite RCS torque.
      Do not raise ForceMagnitude: vanilla gyro control would then bypass ACS limits.
    -->
    <Definition xsi:type="MyObjectBuilder_GyroDefinition">
      <Id>
        <TypeId>Gyro</TypeId>
        <SubtypeId>RealisticAcsRcsLarge</SubtypeId>
      </Id>
      <DisplayName>ACS RCS Cluster (Large)</DisplayName>
      <Description>Finite attitude-control cluster for Realistic ACS. Requires the Realistic ACS Pulsar plugin.</Description>
      <Icon>Textures\GUI\Icons\Cubes\RCS_pod.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\RCS_Pod_Main.mwm</Model>
      <Components>
        <Component Subtype="Construction" Count="10" />
        <Component Subtype="Thrust" Count="20" />
        <Component Subtype="SmallTube" Count="8" />
        <Component Subtype="SteelPlate" Count="10" />
        <Component Subtype="Motor" Count="4" />
        <Component Subtype="Computer" Count="10" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BlockPairName>RealisticAcsRcsCluster</BlockPairName>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <BuildTimeSeconds>20</BuildTimeSeconds>
      <EdgeType>Light</EdgeType>
      <PrimarySound>BlockGyroscope</PrimarySound>
      <ResourceSinkGroup>Gyro</ResourceSinkGroup>
      <ForceMagnitude>1</ForceMagnitude>
      <RequiredPowerInput>0.01</RequiredPowerInput>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <EmissiveColorPreset>Extended</EmissiveColorPreset>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>50</PCU>
      <IsAirTight>false</IsAirTight>
      <TargetingGroups>
        <string>Propulsion</string>
      </TargetingGroups>
    </Definition>

    <Definition xsi:type="MyObjectBuilder_ThrustDefinition">
      <Id>
        <TypeId>Thrust</TypeId>
        <SubtypeId>RealisticAcsRcsHydrogenLarge</SubtypeId>
      </Id>
      <DisplayName>ACS Hydrogen RCS Cluster (Large)</DisplayName>
      <Description>High-authority hydrogen attitude-control cluster for Realistic ACS. Uses a conveyor-supplied hydrogen fuel path.</Description>
      <Icon>Textures\GUI\Icons\Cubes\RCS_pod.dds</Icon>
      <CubeSize>Large</CubeSize>
      <BlockTopology>TriangleMesh</BlockTopology>
      <Size x="1" y="1" z="1" />
      <ModelOffset x="0" y="0" z="0" />
      <Model>Models\Cubes\Large\RCS_hydrogen_Pod_Main.mwm</Model>
      <ThrusterType>Hydrogen</ThrusterType>
      <Components>
        <Component Subtype="SteelPlate" Count="15" />
        <Component Subtype="Construction" Count="10" />
        <Component Subtype="SmallTube" Count="10" />
        <Component Subtype="Motor" Count="4" />
        <Component Subtype="MetalGrid" Count="6" />
        <Component Subtype="Computer" Count="2" />
      </Components>
      <CriticalComponent Subtype="Computer" Index="0" />
      <MountPoints>
        <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="1" EndY="1" />
      </MountPoints>
      <BlockPairName>RealisticAcsRcsHydrogenCluster</BlockPairName>
      <MirroringY>Z</MirroringY>
      <MirroringZ>Y</MirroringZ>
      <BuildTimeSeconds>20</BuildTimeSeconds>
      <EdgeType>Light</EdgeType>
      <ResourceSinkGroup>Thrust</ResourceSinkGroup>
      <!-- Native thrust is intentionally negligible. The ACS plugin supplies
           finite torque, while this provides the real hydrogen conveyor path. -->
      <ForceMagnitude>1</ForceMagnitude>
      <FuelConverter>
        <FuelId>
          <TypeId>GasProperties</TypeId>
          <SubtypeId>Hydrogen</SubtypeId>
        </FuelId>
        <Efficiency>1</Efficiency>
      </FuelConverter>
      <MaxPowerConsumption>0.02</MaxPowerConsumption>
      <MinPowerConsumption>0.000000001</MinPowerConsumption>
      <DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
      <DamagedSound>ParticleHeavyMech</DamagedSound>
      <DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
      <DestroySound>WepSmallWarheadExpl</DestroySound>
      <PCU>50</PCU>
      <IsAirTight>false</IsAirTight>
      <TargetingGroups>
        <string>Propulsion</string>
      </TargetingGroups>
    </Definition>

  </CubeBlocks>
</Definitions>
